# Copy to backend/.env and fill in to enable the Groq free tier.
# Without a key, the app runs on the built-in offline fallback engine
# (LLM replies + Whisper STT switch to fallback; neural TTS still works).

# Provider: "auto" (Groq when key present, else fallback) | "groq" | "fallback"
LLM_PROVIDER=auto

# Free API key from https://console.groq.com (free tier models available)
GROQ_API_KEY=

# Free-tier models
GROQ_MODEL=llama-3.3-70b-versatile
WHISPER_MODEL=whisper-large-v3

# Speech: free neural voices (Microsoft edge-tts; falls back to gTTS)
TTS_VOICE_EN=en-IN-SwaraNeural
TTS_VOICE_HI=hi-IN-SwaraNeural

# Agent identity
AGENT_NAME=Meera
AGENT_ROLE=Divyasree property consultant